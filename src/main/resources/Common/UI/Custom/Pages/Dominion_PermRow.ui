      Style: (Default: (LabelStyle: @Allowed, Background: #1f3a28(0.8)), Hovered: (LabelStyle: @Allowed, Background: #2a5136(0.9)), Pressed: (LabelStyle: @Allowed, Background: #183020));
    }

    TextButton #N1 {
      Visible: false;
      FlexWeight: 1;
      Text: "Denied";
      Style: (Default: (LabelStyle: @Denied, Background: #000000(0.3)), Hovered: (LabelStyle: @Denied, Background: #000000(0.45)), Pressed: (LabelStyle: @Denied, Background: #000000(0.55)));
    }
  }

  Group #Cell2 {
    Anchor: (Width: 78, Height: 30, Left: 4, Top: 5);

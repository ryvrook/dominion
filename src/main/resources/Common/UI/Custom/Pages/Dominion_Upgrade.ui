$C = "../Common.ui";

Group {
  Anchor: (Height: 52, Bottom: 3);
  Padding: (Horizontal: 8);
  Background: #000000(0.22);
  LayoutMode: Left;

  Group {
    LayoutMode: Top;
    FlexWeight: 1;

    Label #Name {
      Anchor: (Height: 24, Top: 2);
      Style: (FontSize: 15, TextColor: #d3d6db, RenderBold: true, VerticalAlignment: Center);
    }

    Label #Desc {
      Anchor: (Height: 20);
      Style: (FontSize: 12, TextColor: #96a9be, VerticalAlignment: Center);
    }
  }

  Group #Dots {
    LayoutMode: Left;
    Anchor: (Width: 150);

    Group #On0 {
      Visible: false;
      Anchor: (Width: 10, Height: 10, Top: 17, Right: 4);
      Background: (Color: #E8A93B);
    }

    Group #Off0 {
      Visible: false;
      Anchor: (Width: 10, Height: 10, Top: 17, Right: 4);
      Background: (Color: #4a5260);
    }

    Group #On1 {
      Visible: false;
      Anchor: (Width: 10, Height: 10, Top: 17, Right: 4);
      Background: (Color: #E8A93B);
    }

    Group #Off1 {
      Visible: false;
      Anchor: (Width: 10, Height: 10, Top: 17, Right: 4);
      Background: (Color: #4a5260);
    }


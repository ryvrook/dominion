      Background: (Color: #E8A93B);
    }

    Group #Off3 {
      Visible: false;
      Anchor: (Width: 10, Height: 10, Top: 17, Right: 4);
      Background: (Color: #4a5260);
    }

    Group #On4 {
      Visible: false;
      Anchor: (Width: 10, Height: 10, Top: 17, Right: 4);
      Background: (Color: #E8A93B);
    }

    Group #Off4 {
      Visible: false;
      Anchor: (Width: 10, Height: 10, Top: 17, Right: 4);
      Background: (Color: #4a5260);
    }

    Group #On5 {
      Visible: false;
      Anchor: (Width: 10, Height: 10, Top: 17, Right: 4);
      Background: (Color: #E8A93B);
    }

    Group #Off5 {
      Visible: false;
      Anchor: (Width: 10, Height: 10, Top: 17, Right: 4);
      Background: (Color: #4a5260);
    }

    Group #On6 {

  Label #Cost {
    Style: (FontSize: 13, TextColor: #E8A93B, VerticalAlignment: Center, HorizontalAlignment: End);
    Anchor: (Width: 110, Right: 8);
  }

  $C.@SmallSecondaryTextButton #Buy {
    @Anchor = (Width: 90, Top: 10);
    Padding: (Horizontal: 6);
    Visible: false;
  }
}

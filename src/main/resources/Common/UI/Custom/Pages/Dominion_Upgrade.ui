    }

    Group #Off6 {
      Visible: false;
      Anchor: (Width: 10, Height: 10, Top: 17, Right: 4);
      Background: (Color: #4a5260);
    }

    Group #On7 {
      Visible: false;
      Anchor: (Width: 10, Height: 10, Top: 17, Right: 4);
      Background: (Color: #E8A93B);
    }

    Group #Off7 {
      Visible: false;
      Anchor: (Width: 10, Height: 10, Top: 17, Right: 4);
      Background: (Color: #4a5260);
    }

    Group #On8 {

$C = "../Common.ui";
$Sounds = "../Sounds.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 560);

    #Title {
      $C.@Title #PageTitle {
        @Text = "Are you sure";
      }
    }

    #Content {
      Padding: (Vertical: 28, Horizontal: 40);

      Label #Consequence {
        Style: (FontSize: 16, TextColor: #d3d6db, Wrap: true);
        Anchor: (Bottom: 12);
      }

      Label #Wait {
        Style: (FontSize: 13, TextColor: #ffb347);
        Anchor: (Bottom: 8);
      }

      Group {
        LayoutMode: Center;
        Anchor: (Top: 8);

        $C.@TextButton #Confirm {
          @Sounds = $Sounds.@SaveSettings;
          @Anchor = (Right: 4);
          @Text = "Confirm";
          FlexWeight: 1;
        }

        $C.@SecondaryTextButton #Cancel {
          @Sounds = $Sounds.@ButtonsCancel;
          @Anchor = (Left: 4);
          @Text = "Cancel";
          FlexWeight: 1;
        }
      }
    }
  }
}

$C.@BackButton {}

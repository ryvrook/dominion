$C = "../Common.ui";

@CellStyle = LabelStyle(FontSize: 13, TextColor: #96a9be, VerticalAlignment: Center);

Group {
  Anchor: (Height: 40, Bottom: 3);
  Padding: (Horizontal: 8);
  Background: #000000(0.22);
  LayoutMode: Left;

  Group #Online {
    Visible: false;
    Anchor: (Width: 10, Height: 10, Top: 15, Right: 8);
    Background: (Color: #5fd37a);
  }

  Group #Offline {
    Visible: false;
    Anchor: (Width: 10, Height: 10, Top: 15, Right: 8);
    Background: (Color: #4a5260);
  }

  Label #Name {
    Style: (FontSize: 15, TextColor: #d3d6db, RenderBold: true, VerticalAlignment: Center);
    FlexWeight: 1;
  }

  Label #Col1 {
    Style: @CellStyle;
    Anchor: (Width: 84);
  }

  Label #Col2 {
    Style: @CellStyle;
    Anchor: (Width: 76);
  }

  Label #Col3 {
    Style: @CellStyle;
    Anchor: (Width: 96);
  }

  Label #Col4 {
    Style: @CellStyle;
    Anchor: (Width: 80);
  }

  $C.@SmallSecondaryTextButton #B1 {
    @Anchor = (Width: 100, Left: 4, Top: 4);
    Padding: (Horizontal: 6);
    Visible: false;
  }

  $C.@SmallSecondaryTextButton #B2 {
    @Anchor = (Width: 100, Left: 4, Top: 4);
    Padding: (Horizontal: 6);
    Visible: false;
  }

  $C.@SmallSecondaryTextButton #B3 {
    @Anchor = (Width: 100, Left: 4, Top: 4);
    Padding: (Horizontal: 6);
    Visible: false;
  }
}

    Style: (Default: (Background: #ff6fae), Hovered: (Background: #ff6fae(0.75)), Pressed: (Background: #ff6fae(0.55)));
  }

  Button #S11 {
    Anchor: (Width: 28, Height: 28, Top: 6, Right: 8);
    Style: (Default: (Background: #d3d6db), Hovered: (Background: #d3d6db(0.75)), Pressed: (Background: #d3d6db(0.55)));
  }

  Label #Current {
    Style: (FontSize: 13, TextColor: #878e9c, VerticalAlignment: Center, HorizontalAlignment: End);
    FlexWeight: 1;
  }

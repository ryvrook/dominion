    Style: (Default: (Background: #1abc9c), Hovered: (Background: #1abc9c(0.75)), Pressed: (Background: #1abc9c(0.55)));
  }

  Button #S6 {
    Anchor: (Width: 28, Height: 28, Top: 6, Right: 8);
    Style: (Default: (Background: #7fd6ff), Hovered: (Background: #7fd6ff(0.75)), Pressed: (Background: #7fd6ff(0.55)));
  }

  Button #S7 {
    Anchor: (Width: 28, Height: 28, Top: 6, Right: 8);
    Style: (Default: (Background: #3498db), Hovered: (Background: #3498db(0.75)), Pressed: (Background: #3498db(0.55)));
  }

  Button #S8 {
    Anchor: (Width: 28, Height: 28, Top: 6, Right: 8);
    Style: (Default: (Background: #6c5ce7), Hovered: (Background: #6c5ce7(0.75)), Pressed: (Background: #6c5ce7(0.55)));
  }

  Button #S9 {
    Anchor: (Width: 28, Height: 28, Top: 6, Right: 8);
    Style: (Default: (Background: #d99cff), Hovered: (Background: #d99cff(0.75)), Pressed: (Background: #d99cff(0.55)));

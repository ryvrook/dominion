Group {
  Anchor: (Height: 40, Bottom: 4);
  Padding: (Horizontal: 10);
  Background: #000000(0.18);
  LayoutMode: Left;

  Label #Label {
    Style: (FontSize: 14, TextColor: #96a9be, VerticalAlignment: Center);
    Anchor: (Width: 160);
    Text: "Colour";
  }

  Button #S0 {
    Anchor: (Width: 28, Height: 28, Top: 6, Right: 8);
    Style: (Default: (Background: #e74c3c), Hovered: (Background: #e74c3c(0.75)), Pressed: (Background: #e74c3c(0.55)));
  }

  Button #S1 {
    Anchor: (Width: 28, Height: 28, Top: 6, Right: 8);
    Style: (Default: (Background: #ff8c42), Hovered: (Background: #ff8c42(0.75)), Pressed: (Background: #ff8c42(0.55)));
  }

  Button #S2 {
    Anchor: (Width: 28, Height: 28, Top: 6, Right: 8);
    Style: (Default: (Background: #f1c40f), Hovered: (Background: #f1c40f(0.75)), Pressed: (Background: #f1c40f(0.55)));
  }

  Button #S3 {
    Anchor: (Width: 28, Height: 28, Top: 6, Right: 8);
    Style: (Default: (Background: #a3d65c), Hovered: (Background: #a3d65c(0.75)), Pressed: (Background: #a3d65c(0.55)));
  }

  Button #S4 {

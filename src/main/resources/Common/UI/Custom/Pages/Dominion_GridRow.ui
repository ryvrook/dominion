@Cell = LabelStyle(FontSize: 13, TextColor: #f2f4f7, RenderBold: true, HorizontalAlignment: Center, VerticalAlignment: Center);

// Each cell is a filled square. The panel sets its Background colour and the letter on top.
Group {
  Anchor: (Height: 26);
  LayoutMode: Center;

  Group #C0 {
    Anchor: (Width: 24, Height: 24, Right: 2);
    Background: (Color: #2a2f38);

    Label #G0 {
      Style: @Cell;
    }
  }

  Group #C1 {
    Anchor: (Width: 24, Height: 24, Right: 2);
    Background: (Color: #2a2f38);

    Label #G1 {
